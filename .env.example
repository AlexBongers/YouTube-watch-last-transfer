# Path to your OAuth 2.0 client secrets JSON file (from Google Cloud Console)
CLIENT_SECRETS_FILE=client_secrets.json

# Path where the OAuth token will be cached after first login
TOKEN_FILE=token.json

# Default target playlist ID (optional — can also be passed on the CLI)
# DEFAULT_TARGET_PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxx

# Delay between API calls in seconds (to avoid hitting quota too fast)
API_CALL_DELAY=0.5

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
