# Google OAuth2 credentials from https://console.cloud.google.com/
# These are OPTIONAL — if not set, the app will show a setup wizard at /setup
# that guides you through creating credentials and saves them automatically.
#
# If you do set them here (or as Render env vars), the setup wizard is skipped
# and these values take precedence over anything saved through the wizard.
#
# When creating your OAuth 2.0 Client ID (type: Web application), add
# http://localhost:3000/oauth2callback (local) or
# https://<your-service>.onrender.com/oauth2callback (Render)
# as an Authorized redirect URI.
# GOOGLE_CLIENT_ID=your_client_id_here
# GOOGLE_CLIENT_SECRET=your_client_secret_here

# Secret used to sign session cookies. Use a long random string in production.
# Render generates this automatically via the render.yaml "generateValue" option.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Render sets this automatically.
# PORT=3000

# Public base URL of the app (no trailing slash).
# If not set, the app auto-detects it from incoming requests.
# APP_URL=http://localhost:3000
