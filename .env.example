# Google OAuth2 credentials from https://console.cloud.google.com/
# Create an OAuth 2.0 Client ID (type: Web application) and add
# http://localhost:3000/oauth2callback (local) OR
# https://<your-service>.onrender.com/oauth2callback (Render)
# as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Public URL of the app (no trailing slash).
# Local:  http://localhost:3000
# Render: https://<your-service>.onrender.com
APP_URL=http://localhost:3000

# Secret used to sign session cookies. Use a long random string in production.
# Render can generate this automatically via the render.yaml "generateValue" option.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Render sets this automatically; leave unset locally
# to use the default (3000).
# PORT=3000
